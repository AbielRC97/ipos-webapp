@page
@model IndexModel
@{
    ViewData["Title"] = "Listado de Productos";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model.Productos)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Precio.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-MX"))</td>
                <td>@producto.Stock</td>
            </tr>
        }
    </tbody>
</table>

<!-- Formulario para calcular total -->
<form method="post">
    <input type="hidden" asp-for="MostrarTotal" value="true" />
    <button type="submit" class="btn btn-primary mt-3">
        Calcular total del inventario
    </button>
</form>

@if (Model.MostrarTotal)
{
    <div class="mt-2">
        <strong>Total del inventario:</strong> @Model.TotalInventario.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("es-MX"))
    </div>
}