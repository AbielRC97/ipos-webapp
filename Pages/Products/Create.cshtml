@page
@model ipos.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Agregar Producto";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre</label>
        <input asp-for="NuevoProducto.Nombre" class="form-control" id="nombre" />
        <span asp-validation-for="NuevoProducto.Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="precio" class="form-label">Precio</label>
        <input asp-for="NuevoProducto.Precio" class="form-control" id="precio" type="number" step="0.01" />
        <span asp-validation-for="NuevoProducto.Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="stock" class="form-label">Stock</label>
        <input asp-for="NuevoProducto.Stock" class="form-control" id="stock" type="number" />
        <span asp-validation-for="NuevoProducto.Stock" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="/Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
